APP_NAME=ICTU-CodeGym Training Management API
APP_ENV=development
DATABASE_URL=mysql+pymysql://ictu_user:change-me@localhost:3306/ictu_training?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure SMTP to deliver reset links and new-account credentials.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Tuition reminder scheduler and email are opt-in; no worker starts from the API.
ENABLE_TUITION_REMINDER_WORKER=False
TUITION_REMINDER_EMAIL_ENABLED=False
TUITION_REMINDER_MAX_ATTEMPTS=3

# Private development storage; not mounted as a public static directory.
PRIVATE_FILE_STORAGE_DIR=var/private-files
PRIVATE_FILE_MAX_BYTES=20971520

# Run independently with: python -m app.services.class_reminders --loop
ENABLE_NOTIFICATION_WORKER=False
NOTIFICATION_EMAIL_ENABLED=True
CLASS_REMINDER_LEAD_HOURS=12

# Anonymous consultation form limit: 5 submissions per client address per hour.
LEAD_SUBMISSION_LIMIT=5
LEAD_SUBMISSION_WINDOW_SECONDS=3600
